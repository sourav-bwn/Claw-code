{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacks": {
      "languages": ["python"]
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthCheckPath": "/health"
  },
  "port": 8000,
  "services": [
    {
      "name": "uc law-web",
      "source": {
        "root": "./web"
      },
      "startCommand": "uvicorn app:app --host 0.0.0.0 --port 8000"
    }
  ],
  "environmentVariables": {
    "ANTHROPIC_API_KEY": "",
    "OPENAI_API_KEY": "",
    "GEMINI_API_KEY": ""
  }
}
